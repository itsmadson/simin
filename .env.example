# Simin configuration.
#
# Copy to `.env` (which is gitignored) and edit. Every value here has a working
# default, so an empty .env starts a safe offline demo.
#
#   cp .env.example .env && docker compose up

# ── Mode ────────────────────────────────────────────────────────────────────
# lab  = simulated money over real (or generated) prices. Cannot spend anything.
# real = real orders on a real account. See the gate below.
SIMIN_MODE=lab

# offline | paper | coinex | nobitex | wallex
#   offline — generated data, no network, no credentials. The default.
#   coinex  — USDT perpetuals, the dial's leverage levels work in full.
#   nobitex — spot only, Toman. The dial is clamped to 1x and shorts disabled.
SIMIN_VENUE=offline

SIMIN_RISK_LEVEL=4
SIMIN_SYMBOLS=BTCUSDT ETHUSDT SOLUSDT
SIMIN_STARTING_EQUITY=10000
SIMIN_POLL_SECONDS=15

# ── The real-mode gate ──────────────────────────────────────────────────────
# Real trading needs ALL of: mode=real, credentials, this flag, a positive
# capital cap, AND typing the confirmation phrase in the UI. Five separate
# deliberate acts, because the cost of starting a live bot by accident is
# unbounded. This flag has no default and never will.
SIMIN_REAL_MODE_ACKNOWLEDGED=

# Hard ceiling on notional the bot may ever deploy, independent of the dial.
# Start far smaller than you think you need.
SIMIN_MAX_CAPITAL=0

# Emergency brake: when 1, no order of any kind leaves the process.
SIMIN_TRADING_FROZEN=0

# ── Credentials ─────────────────────────────────────────────────────────────
# Read from the environment only. Never sent to the browser, never written to
# disk, never logged. Give the API key trade permission but NOT withdrawal.
SIMIN_COINEX_KEY=
SIMIN_COINEX_SECRET=

SIMIN_NOBITEX_KEY=
SIMIN_NOBITEX_SECRET=
# Override if your venue speaks the same API at a different host.
SIMIN_NOBITEX_BASE_URL=

SIMIN_WALLEX_KEY=
SIMIN_WALLEX_SECRET=

# ── Ports and plumbing ──────────────────────────────────────────────────────
SIMIN_API_PORT=8000
SIMIN_UI_PORT=3000
# The API address as the BROWSER sees it, not as the compose network sees it.
SIMIN_PUBLIC_API_URL=http://localhost:8000
SIMIN_CORS_ORIGINS=http://localhost:3000
SIMIN_LOG_LEVEL=INFO
SIMIN_LOG_JSON=0
