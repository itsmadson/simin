# Every value here has a working default — `docker compose up -d` runs without
# this file at all. Copy it to .env only when you want to change something.

# ---- runtime mode: backtest | paper | live  (live is gated, see docs/03) ----
SIMIN_MODE=paper

# ---- risk profile: conservative | balanced | aggressive ----
# aggressive = max-return hunt; still hard-capped by the risk engine
SIMIN_RISK_PROFILE=balanced

# ---- first-boot data load ----
SIMIN_BOOTSTRAP_SYMBOLS=BTCUSDT ETHUSDT SOLUSDT
SIMIN_BOOTSTRAP_TIMEFRAMES=1h 4h 1d
SIMIN_BOOTSTRAP_START=2022-01-01

# ---- infrastructure ----
SIMIN_API_PORT=8000
# SIMIN_PG_IMAGE=timescale/timescaledb:latest-pg16   # hypertables + compression
# SIMIN_REDIS_IMAGE=redis:7-alpine
# PIP_INDEX_URL=https://<mirror>/simple/             # if pypi.org is unreachable

SIMIN_PG_DSN=postgresql+asyncpg://simin:simin@postgres:5432/simin
SIMIN_REDIS_URL=redis://redis:6379/0
SIMIN_PUBLIC_DATA_BASE=https://api.binance.com
SIMIN_HTTP_TIMEOUT=15

# ---- capital (paper) ----
SIMIN_PAPER_START_BALANCE_IRT=100000000

# ---- venue plugin credentials: NEVER commit real values ----
# SIMIN_VENUE_PLUGIN=my_local_venue_adapter
# SIMIN_VENUE_API_KEY=
# SIMIN_VENUE_API_SECRET=

SIMIN_LOG_LEVEL=INFO
SIMIN_LOG_JSON=true
